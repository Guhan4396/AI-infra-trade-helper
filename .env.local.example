# ── Required: Cron & API protection ──────────────────────────────────────────
# Generate with: openssl rand -base64 32
CRON_SECRET=your-long-random-secret-here

# ── Required: ntfy.sh notifications ──────────────────────────────────────────
# Use a long, unguessable topic name (treat like a password)
# Example: ai-infra-signals-x7k2m9p4q8r3n6w1
NTFY_TOPIC=ai-infra-signals-REPLACE_WITH_RANDOM_SUFFIX

# ── Required for AI Research Tool ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional: Google Sheets (primary price data) ──────────────────────────────
# Service account JSON key (base64-encoded to keep as single env var)
# Encode with: base64 -w0 service-account-key.json
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=

# Google Sheets spreadsheet ID (from the URL)
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# Sheet tab name containing GOOGLEFINANCE data (default: "Prices")
GOOGLE_SHEETS_TAB_NAME=Prices

# ── Fallback: Yahoo Finance is used automatically if Sheets not configured ────
# No key needed for Yahoo Finance fallback (unofficial endpoint)
